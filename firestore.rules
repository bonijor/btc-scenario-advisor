rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'schemaVersion', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() <= 80
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPreferences(data) {
      return data.keys().hasOnly([
          'horizon5m', 'horizon15m', 'web', 'email', 'whatsapp',
          'minProbability', 'quietHours', 'schemaVersion', 'updatedAt'
        ])
        && data.horizon5m is bool
        && data.horizon15m is bool
        && data.web is bool
        && data.email is bool
        && data.whatsapp is bool
        && data.minProbability is int
        && data.minProbability >= 50
        && data.minProbability <= 99
        && data.quietHours is bool
        && data.schemaVersion == 1
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /settings/preferences {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create, update: if isOwner(userId)
          && validPreferences(request.resource.data)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Future membership authority. A signed-in user may read only their own
    // entitlement. Browser clients can never create or modify entitlements.
    match /entitlements/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Default deny for every path that is not explicitly granted above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
